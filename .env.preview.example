# Tastile Web - fixed Cloudflare preview environment
# Cloudflare Workers supplies the HYPERDRIVE binding at runtime.

TASTILE_ENV=preview
NEXT_PUBLIC_APP_URL=https://tastile-web-preview.rebuild-up-up.workers.dev
NEXT_PUBLIC_APEX_HOST=preview.tastile.app
NEXT_PUBLIC_APP_HOST=tastile-web-preview.rebuild-up-up.workers.dev
NEXT_PUBLIC_TASTILE_CORE_URL=https://api.staging.app.tastile.app
CLOUD_API_BASE=https://api.staging.app.tastile.app
TASTILE_RUST_API_URL=https://api.staging.app.tastile.app
TASTILE_USE_RUST_CORE=1
NEXT_PUBLIC_CORE_DIRECT_MODE=0
E2E_BYPASS_AUTH=0
NEXT_PUBLIC_E2E_BYPASS_AUTH=0

BETTER_AUTH_SECRET=
TASTILE_AUTH_DATABASE_URL=
TASTILE_WEB_BRIDGE_SECRET=
