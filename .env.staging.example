# Tastile Web - staging environment
# Copy to .env.staging locally and fill the staging-only secrets.
# Cloudflare Workers uses HYPERDRIVE for BetterAuth; leave the direct URL blank.

TASTILE_ENV=staging
NEXT_PUBLIC_APP_URL=https://staging.app.tastile.app
NEXT_PUBLIC_TASTILE_CORE_URL=https://api.staging.app.tastile.app
CLOUD_API_BASE=https://api.staging.app.tastile.app
TASTILE_RUST_API_URL=https://api.staging.app.tastile.app
TASTILE_USE_RUST_CORE=1
NEXT_PUBLIC_CORE_DIRECT_MODE=0
E2E_BYPASS_AUTH=0
NEXT_PUBLIC_E2E_BYPASS_AUTH=0

BETTER_AUTH_SECRET=
TASTILE_AUTH_DATABASE_URL=
TASTILE_WEB_BRIDGE_SECRET=
NEXT_PUBLIC_APEX_HOST=staging.tastile.app
NEXT_PUBLIC_APP_HOST=staging.app.tastile.app
