{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "next.config.*",
    "src/app/**/{page,layout,route,loading,error,not-found,template,default,icon,opengraph-image,twitter-image}.{ts,tsx}",
    "scripts/configure-cognito-social-idps.ps1"
  ],
  "project": [
    "src/**/*.{ts,tsx,js,jsx,mjs}"
  ],
  "ignore": [
    "src/lib/cognito/session.ts",
    "src/components/ui/**",
    "src/components/execution/ActiveExecutionBadge.tsx",
    "src/components/ScrollPage.tsx",
    "src/components/shell/CommandPalette.tsx",
    "src/components/tiles/dialogs/DeferTileDialog.tsx",
    "src/components/tiles/dialogs/DeleteTileDialog.tsx",
    "src/components/tiles/editor/CompletionPanel.tsx",
    "src/components/tiles/editor/ReferencePicker.tsx",
    "src/components/tiles/editor/RelationshipsPanel.tsx",
    "src/components/tiles/shared/TileActionButtons.tsx",
    "src/components/tiles/TileCardExpandable.tsx",
    "src/components/LanguageToggle.tsx",
    "src/components/NavControls.tsx",
    "src/lib/projection/label-grouping.ts",
    "src/lib/stores/dialog-store.ts",
    "src/lib/stores/labels-store.ts",
    "src/lib/stores/reference-overlay-store.ts",
    "src/lib/styles/button-styles.ts",
    "src/hooks/useScrollProgress.ts",
    "src/lib/animate.ts",
    "src/lib/hooks/use-sse-sync.ts",
    "src/lib/utils/tile-formatters.ts",
    "src/components/calendar/TileBlock.tsx",
    "src/lib/domain/v1/execution.ts",
    "src/lib/hooks/use-calendar-projection.ts",
    "src/lib/projection/calendar-projection.ts",
    "src/lib/hooks/use-execution-engine.ts",
    "src/lib/domain/ids.ts",
    "src/lib/domain/execution.ts",
    "src/features/avatar/UploadAvatar.tsx",
    "src/features/profile/ProfilePanel.tsx",
    "src/lib/avatar/FallbackChain.ts"
  ],
  "ignoreDependencies": ["tailwindcss"],
  "ignoreExportsUsedInFile": true
}
