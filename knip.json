{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "next.config.*",
    "src/app/**/{page,layout,route,loading,error,not-found,template,default,icon,opengraph-image,twitter-image}.{ts,tsx}",
    "scripts/configure-cognito-social-idps.ps1"
  ],
  "project": [
    "src/**/*.{ts,tsx,js,jsx,mjs}"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "@typescript-eslint/typescript-estree",
    "axe-core",
    "openapi-typescript",
    "postcss"
  ],
  "ignore": [
    "src/lib/api/v1/openapi-contract.ts"
  ],
  "ignoreFiles": [
    "src/components/tiles/editor/AutomationPanel.tsx",
    "src/components/tiles/editor/SubPanelHeader.tsx",
    "src/lib/api/v1/openapi-generated.d.ts",
    "src/lib/api/v1/openapi-contract.ts"
  ],
  "ignoreExportsUsedInFile": true
}