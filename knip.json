{
  "$schema": "https://knip.dev/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "src/shared/i18n/index.ts",
    "src/shared/ui/index.ts",
    "src/tile/ui/index.ts",
    "src/execution/model/index.ts",
    "src/calendar/model/index.ts",
    "src/widgets/*/ui/index.ts",
    "src/features/*/ui/index.ts",
    "src/views/dashboard/index.ts",
    "src/shared/hooks/index.ts",
    "src/shared/stores/index.ts",
    "src/shared/context/index.ts",
    "src/shared/query/index.ts",
    "src/shared/auth/index.ts"
  ],
  "ignore": [
    "node_modules/**",
    ".next/**",
    "coverage/**",
    "src/lib/vendored/**",
    "*.config.*",
    "scripts/**",
    "e2e/_manual_walkthrough*.js",
    "e2e/_zoom*.js",
    "src/execution/model/reducer.ts",
    "src/features/create-tile/ui/AvailabilityPanel.tsx",
    "src/features/create-tile/ui/LabelSpanPicker.tsx",
    "src/shared/hooks/use-current-actor.ts"
  ],
  "ignoreDependencies": [
    "@types/node",
    "@types/react",
    "@types/react-dom",
    "typescript",
    "eslint",
    "eslint-config-next",
    "@eslint/eslintrc",
    "vitest",
    "@vitest/coverage-v8",
    "@vitest/ui",
    "jsdom",
    "testing-library",
    "@testing-library/*",
    "sharp"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "dependencies": "warn",
    "unlisted": "warn",
    "unresolved": "warn",
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "duplicated": "warn",
    "enumMembers": "warn"
  }
}
