{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "next.config.*",
    "src/app/**/{page,layout,route,loading,error,not-found,template,default,icon,opengraph-image,twitter-image}.{ts,tsx}",
    "scripts/configure-cognito-social-idps.ps1"
  ],
  "project": [
    "src/**/*.{ts,tsx,js,jsx,mjs}"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "@typescript-eslint/typescript-estree",
    "axe-core",
    "openapi-typescript",
    "postcss",
    "sharp",
    "babel-plugin-react-compiler"
  ],
  "ignore": [
    "src/lib/api/v1/openapi-contract.ts",
    ".reference/**",
    "src/lib/vendored/mantine-schedule/**"
  ],
  "ignoreFiles": [
    "src/components/__probe__.tsx",
    "src/lib/__probe__.ts",
    "src/lib/hooks/use-__probe__.ts",
    "src/lib/domain/v1/__probe__.ts",
    "src/lib/api/v1/openapi-generated.d.ts",
    "src/lib/api/v1/openapi-contract.ts",
    "src/lib/vendored/mantine-schedule/hooks/index.ts",
    "src/components/schedule/eventAdapter.ts",
    "src/components/ui/ProjectTree.tsx"
  ],
  "ignoreExportsUsedInFile": true
}
