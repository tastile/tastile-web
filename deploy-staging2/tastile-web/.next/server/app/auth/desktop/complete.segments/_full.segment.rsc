'?state=' + encodeURIComponent(state) + '#' + fragment.toString();\n  const manual = document.getElementById('desktop-callback-link');\n  if (manual) manual.setAttribute('href', callback);\n  window.setTimeout(() => {\n    window.location.href = callback;\n  }, 350);\n})();\n"}}]]}]
