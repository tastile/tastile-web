{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/auth/layout,_N_T_/auth/desktop/layout,_N_T_/auth/desktop/complete/layout,_N_T_/auth/desktop/complete/page,_N_T_/auth/desktop/complete"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/auth/desktop/complete/__PAGE__",
    "/auth/desktop/complete",
    "/auth/desktop",
    "/auth",
    "/_index",
    "/_head"
  ]
}