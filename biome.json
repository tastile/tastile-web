{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignore": [
      ".next/**",
      "**/*.test.*",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.*",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.sh",
      "**/*.ps1",
      "vitest.config.ts",
      "eslint.config.mts",
      "eslint.config.test.ts",
      "scripts/build-product.mts",
      "scripts/screenshot-calendar.mts",
      "scripts/sops-decrypt.ts",
      "scripts/sops-decrypt.test.ts",
      "knip.json"
    ]
  },
  "formatter": {
    "enabled": true
  },
  "css": {
    "parser": {
      "cssModules": true
    }
  },
  "javascript": {},
  "linter": {
    "enabled": false
  }
}
