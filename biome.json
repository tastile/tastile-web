{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.js", "src/**/*.jsx", "src/**/*.css"],
    "ignore": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.test-d.ts",
      "**/*.test-d.tsx",
      "**/__tests__/**",
      "**/__mocks__/**",
      "**/openapi-generated.d.ts",
      ".next/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "cssModules": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useButtonType": "error",
        "noSvgWithoutTitle": "error",
        "useValidAnchor": "error"
      },
      "suspicious": {
        "noImplicitAnyLet": "error",
        "noArrayIndexKey": "off",
        "noGlobalIsNan": "error",
        "noExplicitAny": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error"
      },
      "style": {
        "useNodejsImportProtocol": "error",
        "noNonNullAssertion": "error"
      },
      "correctness": {
        "useExhaustiveDependencies": "error"
      }
    }
  },
  "overrides": [
    {
      "include": ["src/components/tiles/editor/ConditionEditor.tsx"],
      "formatter": { "enabled": false }
    },
    {
      "include": ["src/lib/vendored/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "complexity": {
            "noForEach": "off"
          },
          "correctness": {
            "noUnknownFunction": "off",
            "useExhaustiveDependencies": "off",
            "useJsxKeyInIterable": "off"
          }
        }
      }
    }
  ]
}
