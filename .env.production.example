# Tastile Web - Production environment
# Example values use placeholder hostnames; production deployment must NOT use *.tastile.app as a default
# required — set this value; do NOT use the public tastile.app host for development
# Usage: cp .env.product.example .env.product && fill secrets
# DO NOT commit .env.product with real secrets

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=<required>
TASTILE_DESKTOP_MANIFEST_URL=<required>
NEXT_PUBLIC_TASTILE_DESKTOP_VERSION=
TASTILE_DESKTOP_VERSION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_DAEMON_BASE_URL=<required>
CLOUD_API_BASE=<required>
NEXT_PUBLIC_COGNITO_HOSTED_UI_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_REGION=ap-northeast-1
NEXT_PUBLIC_COGNITO_ISSUER=
NEXT_PUBLIC_COGNITO_JWKS_URL=
NEXT_PUBLIC_COGNITO_CALLBACK_URL=<required>
NEXT_PUBLIC_COGNITO_LOGOUT_URL=<required>
NEXT_PUBLIC_COGNITO_ENABLED_PROVIDERS=Google,SignInWithApple
TASTILE_WEB_BRIDGE_SECRET=
TASTILE_RUST_API_URL=
TASTILE_USE_RUST_CORE=1
NEXT_PUBLIC_APEX_HOST=<required>
NEXT_PUBLIC_APP_HOST=<required>
