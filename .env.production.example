# Tastile Web - Production environment
# Example values use placeholder hostnames; production deployment must NOT use *.tastile.app as a default
# required — set this value; do NOT use the public tastile.app host for development
# Usage: cp .env.product.example .env.product && fill secrets
# DO NOT commit .env.product with real secrets

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=<required>
TASTILE_DESKTOP_MANIFEST_URL=<required>
NEXT_PUBLIC_TASTILE_DESKTOP_VERSION=
TASTILE_DESKTOP_VERSION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_DAEMON_BASE_URL=<required>
# Canonical web-client base URL — this is the public prod API
# (https://api.tastile.app). Read first by src/shared/api/endpoints.ts
# resolveCoreBaseUrl(). Browser calls auto-route through /api/proxy when the
# host differs from localhost (see shouldUseProxyBridge), which forwards to
# CLOUD_API_BASE below. For a "dev → prod API" smoke test, mirror the same
# value in .env.development and start the dev server with `bun run dev:prod`.
NEXT_PUBLIC_TASTILE_CORE_URL=https://api.tastile.app
# Set to "1" to bypass /api/proxy and call CLOUD_API_BASE directly from the
# browser (requires the prod API to allow CORS and the client to hold a valid
# bearer token). Leave "0" so requests stay on the same origin via the
# server-side proxy bridge.
NEXT_PUBLIC_CORE_DIRECT_MODE=0
CLOUD_API_BASE=<required>
# --- BetterAuth (ADR 2026-08-22: Cognito -> BetterAuth) ---
BETTER_AUTH_SECRET=
# Dedicated least-privilege role for the auth schema on the same RDS instance.
TASTILE_AUTH_DATABASE_URL=
# Social providers (each provider activates when both vars are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: Android OAuth 2.0 client ID registered in Google Cloud Console as
# the `app.tastile.android` Android client (debug + release SHA-1).
# When set, BetterAuth accepts idTokens from BOTH this client and GOOGLE_CLIENT_ID
# (above). Leave blank on environments that don't need Android sign-in.
GOOGLE_ANDROID_CLIENT_ID=
APPLE_CLIENT_ID=
# Pre-signed ES256 client-secret JWT for Sign in with Apple
APPLE_CLIENT_SECRET=
# Transactional email via SES (verification / password reset)
TASTILE_SES_FROM_ADDRESS=
TASTILE_SES_REGION=ap-northeast-1
TASTILE_SES_CONFIGURATION_SET=
TASTILE_WEB_BRIDGE_SECRET=
TASTILE_RUST_API_URL=
TASTILE_USE_RUST_CORE=1
NEXT_PUBLIC_APEX_HOST=<required>
NEXT_PUBLIC_APP_HOST=<required>
