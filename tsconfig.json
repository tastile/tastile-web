{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"types": ["vitest/globals"],
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/**/*.mts",
		"scripts/**/*.ts",
		"scripts/**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": [
		"node_modules",
		".next",
		"dist",
		"test-results",
		"scripts/generate-openapi-types.ts",
		"scripts/sync-openapi.ts",
		// sops-decrypt.ts is a runtime CI helper (canonical: tastile-root/scripts/sops-decrypt.ts).
		// Excluded from tsc because its AWS SDK deps (@aws-sdk/client-sts, @aws-sdk/client-kms)
		// are not in package.json dependencies — they live in tastile-root's workspace lockfile.
		// The .test.ts companion is excluded for the same reason. Runtime: invoked via `bun run`
		// in the OIDC CI workflow which has its own dep resolution, NOT through app/src.
		// Follow-up: add deps + remove these excludes in a dedicated chore PR.
		"scripts/sops-decrypt.ts",
		"scripts/sops-decrypt.test.ts",
		"e2e/**/*.ts",
		"e2e/**/*.tsx"
	]
}
