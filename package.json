{
  "name": "tastile-web",
  "version": "0.5.1",
  "description": "Tastile web dashboard, PWA, and landing — Next.js client for the Tastile execution control system",
  "private": true,
  "packageManager": "bun@1.4.2",
  "license": "Apache-2.0",
  "author": "361do_sleep <rebuild.up.up@gmail.com> (https://x.com/361do_sleep)",
  "homepage": "https://tastile.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/tastile/tastile-web.git"
  },
  "bugs": {
    "url": "https://github.com/tastile/tastile-web/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "nanoid": ">=3.3.18"
  },
  "scripts": {
    "prebuild": "bun run sync:openapi",
    "dev": "next dev",
    "dev:prod": "NEXT_PUBLIC_TASTILE_CORE_URL=https://api.tastile.app CLOUD_API_BASE=https://api.tastile.app NEXT_PUBLIC_E2E_BYPASS_AUTH=0 bun dev",
    "build": "next build",
    "build:prod": "node scripts/build-product.mts",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint",
    "lint:ds": "bun scripts/check-ds-coverage.mts",
    "lint:biome": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "node scripts/run-vitest.mts",
    "test:e2e": "playwright test",
    "audit:responsive": "bash scripts/audit-responsive-breakpoints.sh",
    "knip": "knip --no-config-hints",
    "check": "bun run lint:biome && bun run lint && bun run typecheck && bun run knip && bun run audit:responsive && bun run test:unit",
    "check:release": "bun run check && bun audit --production --ignore=GHSA-qx2v-qp2m-jg93 --ignore=GHSA-6g55-p6wh-862q --ignore=GHSA-r28c-9q8g-f849 --ignore=GHSA-f88m-g3jw-g9cj && bun run build:prod",
    "sync:openapi": "bun run scripts/sync-openapi.ts",
    "generate-types": "bun run scripts/generate-openapi-types.ts",
    "generate-types:offline": "bun run scripts/generate-openapi-types.ts --offline",
    "doctor": "bunx react-doctor@latest"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1127.0",
    "@aws-sdk/client-sesv2": "^3.1127.0",
    "@aws-sdk/client-sts": "^3.1127.0",
    "@aws-sdk/credential-provider-node": "^3.972.82",
    "@mantine/core": "^9.6.0",
    "@mantine/dates": "^9.6.0",
    "@mantine/form": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.102.8",
    "better-auth": "^1.7.3",
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rrule": "^2.8.1",
    "stripe": "^22.6.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@next/bundle-analyzer": "^16.3.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^5.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "clsx": "^2.1.1",
    "eslint": "^10.10.0",
    "fast-check": "^4.9.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "openapi-typescript": "^7.13.0",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "uuid": "^14.0.2",
    "vitest": "^5.0.0",
    "yakuhanjp": "^4.1.1"
  }
}
