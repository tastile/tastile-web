{
  "name": "tastile-web",
  "version": "0.1.51",
  "description": "Tastile web dashboard, PWA, and landing — Next.js client for the Tastile execution control system",
  "private": true,
  "packageManager": "bun@1.3.14",
  "license": "Apache-2.0",
  "author": "361do_sleep <rebuild.up.up@gmail.com> (https://x.com/361do_sleep)",
  "homepage": "https://tastile.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/tastile/tastile-web.git"
  },
  "bugs": {
    "url": "https://github.com/tastile/tastile-web/issues"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:prod": "node scripts/build-product.mjs",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint",
    "lint:biome": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "node scripts/run-vitest.mjs",
    "test:e2e": "playwright test",
    "knip": "knip --no-config-hints",
    "check": "bun run lint:biome && bun run lint && bun run typecheck && bun run knip && bun run test:unit",
    "check:release": "bun run check && bun audit --production && bun run build:prod",
    "doctor": "bunx react-doctor@latest"
  },
  "dependencies": {
    "@mantine/core": "^9.4.2",
    "@mantine/dates": "^9.4.2",
    "@mantine/form": "^9.4.2",
    "@mantine/hooks": "^9.4.2",
    "@tabler/icons-react": "^3.45.0",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "lucide-react": "^1.26.0",
    "next": "^16.3.0-preview.9",
    "postcss": "^8.5.16",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "yakuhanjp": "^4.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@next/bundle-analyzer": "^16.2.11",
    "@next/eslint-plugin-next": "^16.2.11",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/ui": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react-doctor": "^0.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "^0.35.0"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}