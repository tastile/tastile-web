{
  "name": "tastile-web",
  "version": "0.1.9",
  "private": true,
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "node scripts/run-vitest.mjs",
    "test:e2e": "playwright test",
    "check": "bun run lint && bun run typecheck && bun run test:unit",
    "check:release": "bun run check && bun run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "uuid": "^13.0.2",
    "yakuhanjp": "^4.1.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^29.0.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "^4.1.0"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
