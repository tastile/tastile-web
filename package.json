{
  "name": "tastile-web",
  "version": "0.1.16",
  "private": true,
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:prod": "node scripts/build-product.mjs",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint",
    "lint:biome": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "node scripts/run-vitest.mjs",
    "test:e2e": "playwright test",
    "check": "bun run lint:biome && bun run lint && bun run typecheck && bun run test:unit",
    "check:release": "bun run check && bun audit --production && bun run build:prod"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.2.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^13.0.2",
    "yakuhanjp": "^4.1.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "knip": "^6.25.0",
    "postcss": "8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.16"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
