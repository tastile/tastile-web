{
  "name": "tastile-web",
  "version": "0.1.51",
  "description": "Tastile web dashboard, PWA, and landing — Next.js client for the Tastile execution control system",
  "private": true,
  "packageManager": "bun@1.3.14",
  "license": "Apache-2.0",
  "author": "361do_sleep <rebuild.up.up@gmail.com> (https://x.com/361do_sleep)",
  "homepage": "https://tastile.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/tastile/tastile-web.git"
  },
  "bugs": {
    "url": "https://github.com/tastile/tastile-web/issues"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:prod": "node scripts/build-product.mjs",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint",
    "lint:biome": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "node scripts/run-vitest.mjs",
    "test:e2e": "playwright test",
    "knip": "knip --no-config-hints",
    "check": "bun run lint:biome && bun run lint && bun run typecheck && bun run knip && bun run test:unit",
    "check:release": "bun run check && bun audit --production && bun run build:prod",
    "generate-types": "bun run scripts/generate-openapi-types.ts",
    "generate-types:offline": "bun run scripts/generate-openapi-types.ts --offline",
    "doctor": "bunx react-doctor@latest"
  },
  "dependencies": {
    "@mantine/core": "^9.4.2",
    "@mantine/dates": "^9.4.2",
    "@mantine/form": "^9.4.2",
    "@mantine/hooks": "^9.4.2",
    "@tabler/icons-react": "^3.34.1",
    "@tanstack/react-query": "^5.71.10",
    "lucide-react": "^0.515.0",
    "next": "^16.0.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^17.7.0",
    "zod": "^3.24.3",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@next/bundle-analyzer": "^16.2.12",
    "@next/eslint-plugin-next": "^16.0.7",
    "@playwright/test": "^1.53.1",
    "@tailwindcss/postcss": "^4.1.7",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "clsx": "^2.1.1",
    "eslint": "^9.30.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^26.1.0",
    "knip": "^5.53.0",
    "openapi-typescript": "^7.13.0",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "uuid": "^14.0.1",
    "vitest": "^4.1.10",
    "yakuhanjp": "^4.1.1"
  }
}
