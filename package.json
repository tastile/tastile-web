{
  "name": "tastile-web",
  "version": "0.4.0",
  "description": "Tastile web dashboard, PWA, and landing — Next.js client for the Tastile execution control system",
  "private": true,
  "packageManager": "bun@1.3.14",
  "license": "Apache-2.0",
  "author": "361do_sleep <rebuild.up.up@gmail.com> (https://x.com/361do_sleep)",
  "homepage": "https://tastile.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/tastile/tastile-web.git"
  },
  "bugs": {
    "url": "https://github.com/tastile/tastile-web/issues"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "overrides": {
    "nanoid": ">=3.3.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:prod": "node scripts/build-product.mts",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint",
    "lint:biome": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "node scripts/run-vitest.mts",
    "test:e2e": "playwright test",
    "knip": "knip --no-config-hints",
    "check": "bun run lint:biome && bun run lint && bun run typecheck && bun run knip && bun run test:unit",
    "check:release": "bun run check && bun audit --production --ignore=GHSA-qx2v-qp2m-jg93 --ignore=GHSA-6g55-p6wh-862q --ignore=GHSA-r28c-9q8g-f849 --ignore=GHSA-f88m-g3jw-g9cj && bun run build:prod",
    "generate-types": "bun run scripts/generate-openapi-types.ts",
    "generate-types:offline": "bun run scripts/generate-openapi-types.ts --offline",
    "doctor": "bunx react-doctor@latest"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1116.0",
    "@mantine/core": "^9.5.1",
    "@mantine/dates": "^9.5.1",
    "@mantine/form": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.101.4",
    "better-auth": "^1.7.1",
    "lucide-react": "^0.515.0",
    "next": "^16.3.0",
    "pg": "^8.23.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rrule": "^2.8.1",
    "stripe": "^17.7.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@next/bundle-analyzer": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "clsx": "^2.1.1",
    "eslint": "^9.39.5",
    "fast-check": "^4.9.0",
    "jiti": "^2.7.0",
    "jsdom": "^26.1.0",
    "knip": "^6.32.0",
    "openapi-typescript": "^7.13.0",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.2",
    "uuid": "^14.0.1",
    "vitest": "^4.1.10",
    "yakuhanjp": "^4.1.1"
  }
}