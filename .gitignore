# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/.next-*/
/out/

# production
/build
/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
bun-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.development.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# local editor and tooling
.idea/

# build artifacts and debug files
tastile-web-*.zip
tastile-web-*.tar.gz
ssh-err.txt
ssh-out.txt
.vscode/

# SSM / deploy scratch
.ssm-*.json
.ssm-err.log
.presign-url*
.presigned-url*
.deploy-staging-*/
.next-old/

# local probe / diagnostic output
probe*.out
probe*raw*.json

# local event store
/.tastile-data/

# Claude / agent / IDE tooling
.claude/
.agents/

# Dist artifacts / screenshots / zips
.tmp-screens/
dist/

# Build / cache
.turbo/
bun.lockb.bak

# Diagnostic artifacts (react-doctor, debug screenshots, manual walkthroughs)
# policy §30 / §31: scratch evidence never enters release.
# Kept tracked: evidence/2026-07-29-*/ (plan evidence bundles),
# evidence/web-*.txt (point-in-time snapshots).
.doctor-cache/
evidence/doctor/
evidence/*.log
evidence/*.network-response
evidence/manual-*.log
evidence/verify-*.log
evidence/web-verify-*.log
/*-2026*.png

.reference/*
.schemathesis/
docs/trace/

# Generated / throwaway artifacts (policy §30 / §31)
.tmp/
/openapi.json
/.openapi-cache.json
# Local dev-server lifecycle artifacts (never enter release)
/dev-server.log
/dev-server.pid
# Plan evidence: screenshots are scratch, JSON evidence is committed separately
/docs/plans/evidence/**/screenshots/
/docs/plans/evidence/**/dev-server.log
/docs/plans/evidence/**/dev-server.pid
# sops loader output (plain text .env files)
!.env.*.sops
